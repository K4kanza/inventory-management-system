DJANGO_SETTINGS_MODULE=config.settings.development

# Optional locally. config.settings.development falls back to a throwaway
# dev-only key, so this is only needed to test signed-cookie behaviour.
# config.settings.production and config.settings.vercel REQUIRE it and refuse
# to boot without it.
DJANGO_SECRET_KEY=

# Required by config.settings.production / config.settings.vercel.
# Comma separated. Both accept bare hosts; CSRF origins gain an https:// scheme.
# ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://example.com,example.com

# config.settings.vercel requires a PostgreSQL URL (Neon integration supplies it).
# DATABASE_URL=postgres://inventory:inventory_dev_password@localhost:5432/inventory
